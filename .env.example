# ─────────────────────────────────────────────────────────────
# DevBridge — variables d'environnement
# Copier ce fichier en « .env.local » puis remplir les valeurs.
# ─────────────────────────────────────────────────────────────

# Adresse publique du site (sans barre finale).
# En local : http://localhost:3000 — en production : l'adresse Vercel ou le domaine.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Clé publique : « anon » (ancien format) ou « publishable » (nouveau format).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète : « service_role » (ancien format) ou « secret » (nouveau format).
# Utilisée UNIQUEMENT côté serveur : données de démonstration et suppression de compte.
# Ne jamais la préfixer par NEXT_PUBLIC_ et ne jamais la versionner.
SUPABASE_SERVICE_ROLE_KEY=

# Affiche les accès de démonstration sur la page de connexion (true / false).
NEXT_PUBLIC_DEMO_MODE=false
# Mot de passe commun des comptes de démonstration (créés par « npm run seed »).
DEMO_PASSWORD=
# Domaine des adresses e-mail de démonstration (aucun e-mail n'y est envoyé).
DEMO_EMAIL_DOMAIN=demo.devbridge.test

# Coordonnées affichées dans le pied de page (laisser vide pour masquer).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SOCIAL_GITHUB=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=
